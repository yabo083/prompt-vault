{
  "name": "prompt-vault",
  "private": true,
  "version": "1.3.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/cli"
  ],
  "engines": {
    "node": ">=20.20"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx src/server/index.ts",
    "cli": "tsx src/cli/index.ts",
    "start": "node dist/server/index.js",
    "build": "tsc -b && npm run build:server && npm run build:cli && vite build",
    "build:server": "tsc -p tsconfig.build.json",
    "build:cli": "tsc -p tsconfig.cli.build.json",
    "typecheck": "tsc -b",
    "pretest": "npm run build:server && npm run build:cli",
    "test": "vitest run"
  },
  "dependencies": {
    "@antv/g6": "5.1.1",
    "@antv/g6-extension-react": "0.2.7",
    "@fontsource-variable/geist": "^5.2.8",
    "@hono/node-server": "^2.0.12",
    "@monaco-editor/react": "4.7.0",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tanstack/react-query": "5.83.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "framer-motion": "^12.42.2",
    "hono": "^4.12.32",
    "lucide-react": "0.468.0",
    "proper-lockfile": "^4.1.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.0",
    "@types/node": "^20.19.43",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "overrides": {
    "dompurify": "3.4.12"
  }
}
