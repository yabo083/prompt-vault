{
  "name": "@miyako-lab/prompt-vault-cli",
  "version": "1.3.1",
  "description": "Run a local Prompt Vault or connect agents to an external Vault Host",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "bin": {
    "prompt-vault": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "static",
    "npm-shrinkwrap.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yabo083/prompt-vault.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/yabo083/prompt-vault#readme",
  "bugs": {
    "url": "https://github.com/yabo083/prompt-vault/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/clean-cli-package.mjs && npm run build --prefix ../.. && node ../../scripts/prepare-cli-package.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "commander": "^14.0.3",
    "diff": "^9.0.0",
    "hono": "^4.12.32",
