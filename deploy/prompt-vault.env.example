# Set this when Prompt Vault is served through a stable public origin.
# PROMPT_VAULT_PUBLIC_URL=https://vault.example.com

# Comma-separated proxy IP addresses allowed to supply client IP headers.
# PROMPT_VAULT_TRUSTED_PROXIES=127.0.0.1

# The Host Token is generated in PROMPT_VAULT_TOKEN_FILE on first start.
# Keep that file private and include it in protected deployment-state backups.
