[Unit]
Description=Prompt Vault
After=network.target

[Service]
Type=simple
User=prompt-vault
Group=prompt-vault
WorkingDirectory=/opt/prompt-vault/current
Environment=PORT=8767
Environment=HOST=127.0.0.1
Environment=PROMPT_VAULT_WORKSPACE=/var/lib/prompt-vault/workspace
Environment=PROMPT_VAULT_TOKEN_FILE=/var/lib/prompt-vault/.vault-token
Environment=PROMPT_VAULT_CREDENTIAL_DIRECTORY=/var/lib/prompt-vault/.vault-auth
Environment=PROMPT_VAULT_BROWSER_SESSION_DIRECTORY=/var/lib/prompt-vault/.browser-sessions
Environment=PROMPT_VAULT_STATIC_DIRECTORY=/opt/prompt-vault/current/static/dist
EnvironmentFile=-/etc/prompt-vault/prompt-vault.env
ExecStart=/usr/bin/node /opt/prompt-vault/current/dist/server/index.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/prompt-vault

[Install]
WantedBy=multi-user.target
